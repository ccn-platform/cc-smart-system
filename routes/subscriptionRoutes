  const express = require("express");
const router = express.Router();

const {
  protect,
  branchAccess
} = require("../middleware/authMiddleware");

const Branch =
  require("../models/Branch");

const clickpesa =
  require("../services/clickpesaService");

const {
  activatePlan
} = require("../services/subscriptionService");


// ============================================================
// PLAN PRICES
// ============================================================

const plans = {
  weekly: 2000,
  monthly: 5200,
  six_months: 30000,
  yearly: 60000
};


// ============================================================
// INITIATE PAYMENT
// ============================================================

router.post(
  "/pay",
  protect,

  async (req, res) => {

    let paymentInitiated = false;
    let branchId;

    try {

      const {
        plan
      } = req.body;


      // ========================================================
      // VALIDATE PLAN
      // ========================================================

      if (
        !plan ||
        !plans[plan]
      ) {

        return res.status(400).json({
          message:
            "Invalid plan"
        });

      }


      // ========================================================
      // BRANCH
      // ========================================================

      branchId =
        req.headers["x-branch-id"];


      if (
        !branchId
      ) {

        return res.status(400).json({
          message:
            "No branch selected"
        });

      }


      const branch =
        await Branch.findById(
          branchId
        );


      if (
        !branch
      ) {

        return res.status(404).json({
          message:
            "Branch not found"
        });

      }


      // ========================================================
      // BLOCK ACTIVE PENDING PAYMENT
      // ========================================================

      if (
        branch.pendingPlan &&
        branch.pendingExpiresAt &&
        branch.pendingExpiresAt >
          new Date()
      ) {

        return res.status(400).json({
          message:
            "Una ombi la malipo ambalo bado linaendelea kusubiri. Tafadhali subiri hadi dakika 6 likamilike au muda wake uishe kabla ya kujaribu tena. Ukipata tatizo wasiliana nasi kwa 0758078629."
        });

      }


      // ========================================================
      // CLEAR EXPIRED PAYMENT
      // ========================================================

      if (
        branch.pendingExpiresAt &&
        branch.pendingExpiresAt <=
          new Date()
      ) {

        branch.pendingPlan =
          null;

        branch.paymentReference =
          null;

        branch.pendingExpiresAt =
          null;

        branch.paymentProcessing =
          false;

        branch.paymentStatus =
          "idle";

        branch.paymentCompletedAt =
          null;

        await branch.save();

      }


      // ========================================================
      // AMOUNT
      // ========================================================

      const amount =
        plans[plan];


      // ========================================================
      // UNIQUE REFERENCE
      // ========================================================

      const reference =
        `CCN${Date.now()}${Math.floor(
          Math.random() * 1000
        )}`;


      // ========================================================
      // SAVE PENDING PAYMENT
      // ========================================================

      branch.pendingPlan =
        plan;

      branch.paymentReference =
        reference;

      branch.pendingExpiresAt =
        new Date(
          Date.now() +
            6 *
              60 *
              1000
        );

      branch.paymentProcessing =
        false;

      branch.paymentStatus =
        "pending";

      branch.paymentCompletedAt =
        null;


      await branch.save();


      // ========================================================
      // CLICKPESA PUSH
      // ========================================================

      await clickpesa.mobilePush(
        branch.phone ||
          req.user.phone,
        amount,
        reference
      );


      paymentInitiated =
        true;


      // ========================================================
      // RESPONSE
      // ========================================================

      return res.json({

        success: true,

        reference,

        subscriptionAmount:
          amount,

        message:
          "Ombi la malipo limetumwa. Tafadhali angalia simu yako, weka namba yako ya siri ili ukamilishe malipo."

      });

    } catch (e) {

      console.error(
        "❌ SUBSCRIPTION PAYMENT INITIATION ERROR:",
        e
      );


      // ========================================================
      // CLEAN FAILED INITIATION
      // ========================================================

      if (
        !paymentInitiated &&
        branchId
      ) {

        try {

          await Branch.findByIdAndUpdate(
            branchId,
            {

              pendingPlan:
                null,

              paymentReference:
                null,

              pendingExpiresAt:
                null,

              paymentProcessing:
                false,

              paymentStatus:
                "failed",

              paymentCompletedAt:
                null

            }
          );

        } catch (
          cleanupError
        ) {

          console.error(
            "❌ PAYMENT CLEANUP ERROR:",
            cleanupError
          );

        }

      }


      return res.status(400).json({

        message:
          `${e.message}. kwa tatizo hili la malipo ili kupata msaada wasiliana nasi kwa 0758078629`

      });

    }

  }
);


// ============================================================
// SUBSCRIPTION PAYMENT STATUS
//
// GET /subscription/status
// ============================================================

router.get(
  "/status",
  protect,

  async (req, res) => {

    try {

      const branchId =
        req.headers["x-branch-id"];


      if (
        !branchId
      ) {

        return res.status(400).json({
          message:
            "No branch selected"
        });

      }


      const branch =
        await Branch.findById(
          branchId
        ).lean();


      if (
        !branch
      ) {

        return res.status(404).json({
          message:
            "Branch not found"
        });

      }


      const now =
        new Date();


      const expired =
        Boolean(
          branch.pendingExpiresAt &&
          new Date(
            branch.pendingExpiresAt
          ) <= now
        );


      return res.status(200).json({

        success:
          true,

        paymentStatus:
          branch.paymentStatus ||
          "idle",

        pendingPlan:
          branch.pendingPlan ||
          null,

        paymentReference:
          branch.paymentReference ||
          null,

        paymentCompletedAt:
          branch.paymentCompletedAt ||
          null,

        pendingExpiresAt:
          branch.pendingExpiresAt ||
          null,

        subscription:
           branch.subscription || null,

        expired

      });

    } catch (error) {

      console.error(
        "❌ SUBSCRIPTION STATUS ERROR:",
        error
      );


      return res.status(500).json({

        message:
          error?.message ||
          "Failed to check subscription status"

      });

    }

  }
);


 
 
// ============================================================
// CLICKPESA CALLBACK
// ============================================================

router.post(
  "/callback",

  async (req, res) => {

    let branch = null;

    try {

      // ========================================================
      // RECEIVE PAYLOAD
      // ========================================================

      const payload =
        req.body?.data ||
        req.body ||
        {};


      console.log(
        "=================================================="
      );

      console.log(
        "📥 CLICKPESA CALLBACK RECEIVED"
      );

      console.log(
        "📦 CALLBACK BODY:",
        JSON.stringify(
          req.body,
          null,
          2
        )
      );


      // ========================================================
      // REFERENCE
      // ========================================================

      const reference =
        payload.orderReference ||
        payload.reference ||
        payload.transaction_reference ||
        payload.merchant_reference;


      // ========================================================
      // STATUS
      // ========================================================

      const status =
        payload.status ||
        payload.payment_status ||
        payload.result;


      const normalizedStatus =
        String(
          status || ""
        )
          .trim()
          .toUpperCase();


      console.log(
        "🔑 CALLBACK REFERENCE:",
        reference
      );

      console.log(
        "📊 CALLBACK STATUS:",
        normalizedStatus
      );


      // ========================================================
      // REFERENCE MUST EXIST
      // ========================================================

      if (!reference) {

        console.error(
          "❌ CALLBACK HAS NO PAYMENT REFERENCE"
        );

        return res.sendStatus(
          200
        );

      }


      // ========================================================
      // ONLY SUCCESS PAYMENT ACTIVATES
      // ========================================================

      if (
        ![
          "SUCCESS",
          "SUCCESSFUL",
          "PAID"
        ].includes(
          normalizedStatus
        )
      ) {

        console.log(
          "⏳ PAYMENT NOT SUCCESSFUL - NO ACTIVATION",
          {
            reference,
            status:
              normalizedStatus
          }
        );

        return res.sendStatus(
          200
        );

      }


      // ========================================================
      // FIND PENDING PAYMENT
      //
      // We first find the branch using the payment reference.
      // ========================================================

      branch =
        await Branch.findOne({
          paymentReference:
            reference
        });


      // ========================================================
      // NO BRANCH FOUND
      // ========================================================

      if (!branch) {

        console.error(
          "❌ NO BRANCH FOUND FOR PAYMENT REFERENCE:",
          reference
        );

        return res.sendStatus(
          200
        );

      }


      // ========================================================
      // LOG PAYMENT STATE
      // ========================================================

      console.log(
        "🏪 BRANCH FOUND:",
        String(
          branch._id
        )
      );

      console.log(
        "📋 CURRENT PAYMENT STATE:",
        {
          paymentReference:
            branch.paymentReference,

          pendingPlan:
            branch.pendingPlan,

          pendingExpiresAt:
            branch.pendingExpiresAt,

          paymentProcessing:
            branch.paymentProcessing,

          paymentStatus:
            branch.paymentStatus
        }
      );


      // ========================================================
      // DUPLICATE CALLBACK PROTECTION
      // ========================================================

      if (
        branch.paymentProcessing === true
      ) {

        console.log(
          "⏳ PAYMENT IS ALREADY BEING PROCESSED:",
          reference
        );

        return res.sendStatus(
          200
        );

      }


      // ========================================================
      // PAYMENT ALREADY COMPLETED
      // ========================================================

      if (
        branch.paymentStatus ===
        "success"
      ) {

        console.log(
          "✅ PAYMENT ALREADY COMPLETED:",
          reference
        );

        return res.sendStatus(
          200
        );

      }


      // ========================================================
      // PLAN MUST EXIST
      // ========================================================

      if (
        !branch.pendingPlan
      ) {

        console.error(
          "❌ PAYMENT FOUND BUT pendingPlan IS EMPTY:",
          {
            reference,
            branchId:
              String(
                branch._id
              )
          }
        );

        return res.sendStatus(
          200
        );

      }


      // ========================================================
      // LOCK PAYMENT
      // ========================================================

      branch.paymentProcessing =
        true;

      await branch.save();


      // ========================================================
      // PLAN
      // ========================================================

      const planToActivate =
        branch.pendingPlan;


      console.log(
        "🚀 ACTIVATING SUBSCRIPTION:",
        {
          branchId:
            String(
              branch._id
            ),

          plan:
            planToActivate,

          reference
        }
      );


      // ========================================================
      // ACTIVATE PLAN
      // ========================================================

      await activatePlan(
        branch,
        planToActivate
      );


      // ========================================================
      // MARK PAYMENT SUCCESS
      // ========================================================

      branch.paymentStatus =
        "success";

      branch.paymentCompletedAt =
        new Date();

      branch.pendingPlan =
        null;

      branch.paymentReference =
        null;

      branch.pendingExpiresAt =
        null;

      branch.paymentProcessing =
        false;


      // ========================================================
      // SAVE EVERYTHING
      // ========================================================

      await branch.save();


      // ========================================================
      // SUCCESS LOG
      // ========================================================

      console.log(
        "=================================================="
      );

      console.log(
        "✅ SUBSCRIPTION ACTIVATED SUCCESSFULLY"
      );

      console.log(
        "🏪 BRANCH:",
        String(
          branch._id
        )
      );

      console.log(
        "📦 PLAN:",
        planToActivate
      );

      console.log(
        "💳 REFERENCE:",
        reference
      );

      console.log(
        "⏰ ACTIVATED AT:",
        branch.paymentCompletedAt
      );

      console.log(
        "=================================================="
      );


      // ========================================================
      // ACKNOWLEDGE CLICKPESA
      // ========================================================

      return res.sendStatus(
        200
      );


    } catch (e) {

      // ========================================================
      // CALLBACK ERROR
      // ========================================================

      console.error(
        "=================================================="
      );

      console.error(
        "❌ CLICKPESA CALLBACK ERROR"
      );

      console.error(
        e
      );

      console.error(
        "=================================================="
      );


      // ========================================================
      // UNLOCK PAYMENT IF ERROR OCCURRED
      // ========================================================

      if (
        branch
      ) {

        try {

          branch.paymentProcessing =
            false;

          await branch.save();

        } catch (
          unlockError
        ) {

          console.error(
            "❌ FAILED TO UNLOCK PAYMENT:",
            unlockError
          );

        }

      }


      // ========================================================
      // RETURN ERROR
      // ========================================================

      return res.sendStatus(
        500
      );

    }

  }
); 

// ============================================================
// TEST ACTIVATION
// ============================================================

router.post(
  "/activate",
  protect,
  branchAccess,

  async (req, res) => {

    try {

      const {
        plan
      } = req.body;


      const branch =
        await Branch.findById(
          req.branchId
        );


      if (
        !branch
      ) {

        return res.status(404).json({
          message:
            "Branch not found"
        });

      }


      const subscription =
        await activatePlan(
          branch,
          plan
        );


      return res.json({

        message:
          "Activated (TEST MODE)",

        subscription

      });

    } catch (e) {

      console.error(
        e
      );


      return res.status(400).json({
        message:
          e.message
      });

    }

  }
);


module.exports =
  router;

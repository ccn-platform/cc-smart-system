  const express =
  require("express");

const router =
  express.Router();

const {
  protect
} = require(
  "../middleware/authMiddleware"
);

const {
  getMyReferral,
  getMyReferrals,
  getReferralDashboard,
  getReferralById
} = require(
  "../controllers/referralController"
);


// =========================================
// MY REFERRAL INFO
// =========================================

router.get(
  "/my",
  protect,
  getMyReferral
);


// =========================================
// MY REFERRALS
// =========================================

router.get(
  "/list",
  protect,
  getMyReferrals
);


// =========================================
// DASHBOARD
// =========================================

router.get(
  "/dashboard",
  protect,
  getReferralDashboard
);


// =========================================
// SINGLE REFERRAL
// =========================================

router.get(
  "/:id",
  protect,
  getReferralById
);


module.exports =
  router;
